

# Copy this file to `.env` and fill in your credentials.
# IMPORTANT: Do NOT commit your `.env` file. Keep secrets out of version control.

# Clerk (publishable - safe for client if truly publishable; prefer server keys on backend)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# PostgreSQL Database URL (use a secure, non-public DB URL for production)
DATABASE_URL=postgresql://username:password@localhost:5432/Uber-clone

# Public server/origin used by the app (optional)
EXPO_PUBLIC_SERVER_URL=https://example.com/

# Map service keys (replace with your own keys)
EXPO_PUBLIC_GEOAPIFY_API_KEY=REPLACE_WITH_YOUR_GEOAPIFY_KEY
EXPO_PUBLIC_GOOGLE_API_KEY=REPLACE_WITH_YOUR_GOOGLE_API_KEY

# Notes:
# - This file is a template. Copy to `.env` and update values before running the app.
# - The repository's `.gitignore` already excludes `.env`. If `.env` has already
#   been committed, run the commands in the repository root to remove it from git
#   history (see README):
#
#   git rm --cached .env
#   git commit -m "Remove .env from repository"
#   git push


